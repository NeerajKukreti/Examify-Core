{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LensEvaluationPayload",
  "description": "Strict structured evaluation payload emitted by each specialized lens in Chamber 1, 2, or 3 during Phase 1 fan-out.",
  "type": "object",
  "properties": {
    "lens_id": {
      "type": "string",
      "enum": [
        "the_monetizer",
        "the_seo_auditor",
        "the_wordsmith",
        "the_pen_tester",
        "the_ergonomist",
        "the_latency_hunter",
        "the_systems_architect",
        "the_auditor",
        "the_chief_risk_officer",
        "the_legal_counsel"
      ]
    },
    "chamber": {
      "type": "string",
      "enum": ["Chamber 1: Commercial & Growth", "Chamber 2: Technical & Defense", "Chamber 3: Risk, Legal & Armor"]
    },
    "status": {
      "type": "string",
      "enum": ["PASS", "FLAGGED", "HARD_VETO"]
    },
    "hard_veto_triggered": {
      "type": "boolean",
      "description": "True ONLY if The Pen Tester (P0 vulnerability) or The Legal Counsel (P0 compliance violation) triggers an unconditional block."
    },
    "hard_veto_rationale": {
      "type": ["string", "null"],
      "description": "Detailed justification if hard veto was triggered."
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "issue_id": { "type": "string" },
          "title": { "type": "string" },
          "severity": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5,
            "description": "1: Trivial/Style, 2: Minor, 3: Moderate, 4: High, 5: Critical / P0"
          },
          "target_file": { "type": "string" },
          "line_range": { "type": "string" },
          "description": { "type": "string" },
          "metric_impact": {
            "type": "object",
            "properties": {
              "latency_ms_delta": { "type": "number" },
              "conversion_percent_delta": { "type": "number" },
              "monthly_cost_usd_delta": { "type": "number" },
              "resource_reserve_headroom_percent": { "type": "number" }
            },
            "additionalProperties": false
          },
          "proposed_diff": {
            "type": "string",
            "description": "Unified git diff showing the precise code modification."
          },
          "concession": {
            "type": ["string", "null"],
            "description": "What trade-off this lens is willing to concede to opposing chambers."
          }
        },
        "required": ["issue_id", "title", "severity", "target_file", "description", "proposed_diff"],
        "additionalProperties": false
      }
    },
    "summary": { "type": "string" }
  },
  "required": ["lens_id", "chamber", "status", "hard_veto_triggered", "issues", "summary"],
  "additionalProperties": false
}
