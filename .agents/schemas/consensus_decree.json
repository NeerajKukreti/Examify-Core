{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ConsensusDecreePayload",
  "description": "Strict JSON schema for the final Evolution Synthesizer output including Anti-Obsolescence audit, Hard Veto validations, and Auto-Refactor Directives.",
  "type": "object",
  "properties": {
    "decree_id": { "type": "string" },
    "timestamp_utc": { "type": "string" },
    "verdict": {
      "type": "string",
      "enum": ["CONSENSUS_DECREE_APPROVED", "CONSENSUS_DECREE_CONDITIONAL", "VETO_BLOCKED"]
    },
    "anti_obsolescence_gate": {
      "type": "object",
      "properties": {
        "passed": { "type": "boolean" },
        "target_framework": { "type": "string", "default": ".NET 8.0 (C# 12)" },
        "deprecated_apis_detected": {
          "type": "array",
          "items": { "type": "string" }
        },
        "binding_upgrades": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "package_or_pattern": { "type": "string" },
              "upgrade_requirement": { "type": "string" }
            },
            "required": ["package_or_pattern", "upgrade_requirement"]
          }
        }
      },
      "required": ["passed", "target_framework", "deprecated_apis_detected", "binding_upgrades"],
      "additionalProperties": false
    },
    "veto_registry": {
      "type": "object",
      "properties": {
        "pen_tester_veto_active": { "type": "boolean" },
        "legal_counsel_veto_active": { "type": "boolean" },
        "blocking_reasons": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "required": ["pen_tester_veto_active", "legal_counsel_veto_active", "blocking_reasons"],
      "additionalProperties": false
    },
    "weighted_trade_offs_summary": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "topic": { "type": "string" },
          "latency_impact": { "type": "string" },
          "conversion_impact": { "type": "string" },
          "infrastructure_impact": { "type": "string" },
          "accepted_rationale": { "type": "string" }
        },
        "required": ["topic", "latency_impact", "conversion_impact", "accepted_rationale"]
      }
    },
    "auto_refactor_directives": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "directive_id": { "type": "string" },
          "target_file": { "type": "string" },
          "action": {
            "type": "string",
            "enum": ["MODIFY", "CREATE", "DELETE", "MIGRATE"]
          },
          "summary": { "type": "string" },
          "unified_diff": { "type": "string" },
          "compilation_impact": {
            "type": "string",
            "enum": ["REQUIRES_DOTNET_BUILD", "RUNTIME_INTERPRETED_NO_BUILD"]
          },
          "verification_command": { "type": "string" }
        },
        "required": ["directive_id", "target_file", "action", "summary", "unified_diff", "compilation_impact", "verification_command"],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "decree_id",
    "timestamp_utc",
    "verdict",
    "anti_obsolescence_gate",
    "veto_registry",
    "weighted_trade_offs_summary",
    "auto_refactor_directives"
  ],
  "additionalProperties": false
}
